# Copy to .env and fill in as needed. Never commit real secrets.
# Local: cp .env.example .env

# Hugging Face (models / datasets)
HF_TOKEN=

# Weights & Biases (optional)
WANDB_API_KEY=
WANDB_PROJECT=em-displacement-vlm

# Override storage roots (useful on Colab + Google Drive)
# EM_DATA_DIR=/content/drive/MyDrive/em-displacement-vlm/data
# EM_CHECKPOINT_DIR=/content/drive/MyDrive/em-displacement-vlm/checkpoints
